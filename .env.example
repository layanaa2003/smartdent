# OPTIONAL. SmartDent runs without a .env file (start.bat / start.sh need none).
# Copy this file to .env only if you want to change a setting. Never share or commit .env.

# A long random string that protects login sessions.
# Leave empty and SmartDent makes one itself and keeps it in instance/secret_key.
# Make your own with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The first admin account when you run: python scripts/seed.py  (not --demo)
ADMIN_EMAIL=admin@smartdent.local
ADMIN_NAME=Administrator
# Leave empty to be asked for the password when you run the seed script.
ADMIN_PASSWORD=

# Port of the web app (default 5000; if it is busy the next free port is used).
PORT=5000

# Email (optional). Leave SMTP_HOST empty to use "Download" instead of sending.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an "App password" as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
